library(ggplot2)
library(tidyverse)
library(vcfR)
nprw_vcf <- read.vcfR("NPRW_masked_formatfilters.recode.vcf", verbose = TRUE)
NPRW_depth <- read.table("C:/Users/c_cro/Documents/PhD/DFO/test_vcf/NPRW_depth.txt")
NPRWDP <- NPRW_depth %>%
select(CHROM = V1, SAMPLE = V3, DP = V4)
depth_plot <- ggplot(NPRWDP, aes(group = SAMPLE)) +
geom_col(aes(x=CHROM, y=mean(as.numeric(as.character(DP)), na.rm = TRUE), fill = SAMPLE), position="dodge") +
theme_bw() +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1)) +
ylab("MEAN DEPTH")
aggregate(as.numeric(as.character(DP)) ~ CHROM + SAMPLE, FUN=mean, na.action = na.omit, data=NPRWDP)
depth_plot <- ggplot(NPRWDP, aes(x=CHROM, y=as.numeric(as.character(DP)))) +
geom_boxplot(aes(fill = SAMPLE), position = "dodge", outlier.shape = NA) +
theme_bw() +
ylim(0,75) +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1)) +
ylab("MEAN DEPTH")
depth_plot
library(scales)
breaks <- 10^(-10:10)
minor_breaks <- rep(5, 21)*(10^rep(-10:10, each=9))
setwd("~/Documents/PostDoc/ROH/Data")
high_roh_bcftools <- read.table('HIGH_cod_filtered_variants_ROH.txt', header=TRUE)
high_roh_bcftools$cat <- "HIGH"
high_roh_bcftools_min10kb <-high_roh_bcftools[high_roh_bcftools$Length>=10000,]
low_roh_bcftools <- read.table('LOW_cod_filtered_variants_ROH.txt', header=TRUE)
low_roh_bcftools$cat <- "LOW"
low_roh_bcftools_min10kb <-low_roh_bcftools[low_roh_bcftools$Length>=10000,]
ROH_df <- rbind(HIGH_roh_bcftools, LOW_roh_bcftools)
high_roh_bcftools <- read.table('HIGH_cod_filtered_variants_ROH.txt', header=TRUE)
high_roh_bcftools$cat <- "HIGH"
high_roh_bcftools_min10kb <-high_roh_bcftools[high_roh_bcftools$Length>=10000,]
low_roh_bcftools <- read.table('LOW_cod_filtered_variants_ROH.txt', header=TRUE)
low_roh_bcftools$cat <- "LOW"
low_roh_bcftools_min10kb <-low_roh_bcftools[low_roh_bcftools$Length>=10000,]
ROH_df <- rbind(HIGH_roh_bcftools, LOW_roh_bcftools)
ROH_df <- rbind(iigh_roh_bcftools, low_roh_bcftools)
ROH_df <- rbind(high_roh_bcftools, low_roh_bcftools)
ROH_df_min10kb <- ROH_df[ROH_df$Length>=10000,]
ROH_len <-ggplot(srw_roh_bcftools_min10kb, aes(x = Length, group=Sample), geom="histogram") +
geom_step(stat="bin", bins=20, direction="mid", aes(colour="HIGH"), size = 1) +
geom_step(data=narw_roh_bcftools_min10kb, aes(x=Length, colour="LOW"), stat="bin", bins=20, direction="mid", size = 1) +
theme_bw() +
scale_x_continuous(trans='log10', label=comma, breaks = breaks, minor_breaks = minor_breaks) +
theme(axis.title.x = element_text(size = 14), axis.title.y = element_text(size = 14)) +
scale_colour_manual(name="cat", values = c("HIGH"= "#f1a340","LOW"="#998ec3")) +
xlab("Length of ROH") +
ylab("Number of ROHs") +
annotation_logticks(sides="b")
