library(ggplot2)
library(patchwork)
library(ggpubr)
library(dplyr)
library(scales)
#Load data files
nprw_vcf <-read.table("NPRW_vcftools.LROH", header=TRUE)
# calculate Length
nprw_vcf$lrg_length <- nprw_vcf$MAX_END-nprw_vcf$MIN_START
nprw_vcf$con_length <- nprw_vcf$AUTO_END-nprw_vcf$AUTO_START
#Filter
dups <-nprw_vcf[duplicated(nprw_vcf[,c(1,4:5,8:9)])|duplicated(nprw_vcf[,c(1,4:5,8:9)], fromLast=TRUE),]
dups_1 <- which(duplicated(nprw_vcf[,c(1,4:5,8:9)], fromLast=TRUE))
nprw_vcf_nodup_roh_lrg <- nprw_vcf[-dups_1,]
nprw_vcf_nodup_2mis_roh_lrg<-nprw_vcf_nodup_roh_lrg[nprw_vcf_nodup_roh_lrg$N_MISMATCHES<2,]
#ROH over 100Kb only
NV_roh_lrg_100kb<-nprw_vcf_nodup_2mis_roh_lrg[nprw_vcf_nodup_2mis_roh_lrg$lrg_length>=100000,]
NV_roh_lrg_300kb<-nprw_vcf_nodup_2mis_roh_lrg[nprw_vcf_nodup_2mis_roh_lrg$lrg_length>=300000,]
NV_roh_lrg_1mb<-nprw_vcf_nodup_2mis_roh_lrg[nprw_vcf_nodup_2mis_roh_lrg$lrg_length>=1000000,]
i=1
nprw_table = data.frame()
for (s in unique(NV_roh_lrg_100kb$INDV)){
nprw_table[i,1] = s
nprw_table[i,2] <- sum(NV_roh_lrg_100kb[NV_roh_lrg_100kb$INDV==s,"lrg_length"])/2170759585
nprw_table[i,3] <- sum(NV_roh_lrg_300kb[NV_roh_lrg_300kb$INDV==s,"lrg_length"])/2170759585
nprw_table[i,4] <- sum(NV_roh_lrg_1mb[NV_roh_lrg_1mb$INDV==s,"lrg_length"])/2170759585
i = i+1
}
View(nprw_table)
