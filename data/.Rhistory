#Load Libraries
library(scales)
library(ggplot2)
#Load data files
narw_vcf <-read.table("narw_vcftools.LROH", header=TRUE)
srw_vcf<-read.table("srw_vcftools.LROH", header=TRUE)
# calculate Length
narw_vcf$lrg_length <- narw_vcf$MAX_END-narw_vcf$MIN_START
narw_vcf$con_length <- narw_vcf$AUTO_END-narw_vcf$AUTO_START
srw_vcf$lrg_length <- srw_vcf$MAX_END-srw_vcf$MIN_START
srw_vcf$con_length <- srw_vcf$AUTO_END-srw_vcf$AUTO_START
#Filter
dups <-narw_vcf[duplicated(narw_vcf[,c(1,4:5,8:9)])|duplicated(narw_vcf[,c(1,4:5,8:9)], fromLast=TRUE),]
dups_1 <- which(duplicated(narw_vcf[,c(1,4:5,8:9)], fromLast=TRUE))
narw_vcf_nodup_roh_lrg <- narw_vcf[-dups_1,]
narw_vcf_nodup_2mis_roh_lrg<-narw_vcf_nodup_roh_lrg[narw_vcf_nodup_roh_lrg$N_MISMATCHES<2,]
sdups <-srw_vcf[duplicated(srw_vcf[,c(1,4:5,8:9)])|duplicated(srw_vcf[,c(1,4:5,8:9)], fromLast=TRUE),]
sdups_1 <- which(duplicated(srw_vcf[,c(1,4:5,8:9)], fromLast=TRUE))
srw_vcf_nodup_roh_lrg <- srw_vcf[-sdups_1,]
srw_vcf_nodup_2mis_roh_lrg<-srw_vcf_nodup_roh_lrg[srw_vcf_nodup_roh_lrg$N_MISMATCHES<2,]
#ROH over 100Kb only
NV_roh_lrg_100kb<-narw_vcf_nodup_2mis_roh_lrg[narw_vcf_nodup_2mis_roh_lrg$lrg_length>=100000,]
NV_roh_lrg_100kb
