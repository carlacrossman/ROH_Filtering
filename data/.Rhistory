library(ggplot2)
library(patchwork)
library(scales)
Nmu = 0.9664e-8
Ngen = 32
nprw_msmc <- read.table("NPRW_msmc2.final.txt", sep='\t', header=TRUE)
nprw_t_years <- Ngen * ((nprw_msmc$left_time_boundary + nprw_msmc$right_time_boundary)/2) / Nmu
nprw_pop_size <- (1/nprw_msmc$lambda)/(2*Nmu)
nprw <- data.frame(nprw_t_years, nprw_pop_size)
colnames(nprw) <- c("Years","PopSize")
nprw$Species <- "NPRW"
msmc_plot<- ggplot(nprw, aes(x = Years, y = PopSize)) +
geom_step(size = 2) +
scale_x_continuous(trans='log10', label=comma) +
scale_y_continuous(trans='log10', label=comma) +
theme_bw() +
xlab("Years Before Present") +
ylab("Effective Population Size (Ne)")
